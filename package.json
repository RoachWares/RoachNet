{
  "name": "roachnet",
  "version": "1.1.0",
  "buildNumber": 110,
  "description": "RoachNet offline operations platform",
  "main": "scripts/run-roachnet-native-api.mjs",
  "scripts": {
    "build": "xcrun swift build --package-path native/macos",
    "release:apple-secrets": "bash scripts/configure-apple-release-secrets.sh",
    "native:build": "xcrun swift build --package-path native/macos",
    "native:test": "xcrun swift test --package-path native/macos",
    "native:themes": "node scripts/generate-builtin-themes.mjs",
    "native:dist": "node scripts/build-native-macos-apps.mjs",
    "runtime:build": "swift build --package-path native/macos -c release --product roachnet-runtime",
    "runtime:start": "native/macos/.build/release/roachnet-runtime",
    "test:native-runtime": "ROACHNET_NATIVE_API_BINARY=\"$PWD/native/macos/.build/release/roachnet-runtime\" node --test scripts/tests/*.test.mjs",
    "setup": "node scripts/run-roachnet-setup.mjs",
    "setup:no-browser": "ROACHNET_SETUP_NO_BROWSER=1 node scripts/run-roachnet-setup.mjs",
    "start": "node scripts/run-roachnet-native-api.mjs",
    "start:no-browser": "ROACHNET_NO_BROWSER=1 node scripts/run-roachnet-native-api.mjs",
    "admin:doctor": "node scripts/check-admin-node-runtime.mjs",
    "convex:codegen": "convex codegen --typecheck enable",
    "convex:typecheck": "tsc -p convex/tsconfig.json",
    "convex:deploy": "convex deploy",
    "audit:upstreams": "node scripts/audit-upstream-projects.mjs",
    "audit:release": "node scripts/audit-release-configuration.mjs",
    "audit:privacy": "node scripts/audit-release-privacy.mjs",
    "smoke:macos-install-lanes": "node scripts/smoke-test-macos-install-lanes.mjs",
    "smoke:ios-companion-compat": "node scripts/smoke-test-ios-companion-compat.mjs",
    "smoke:release-gates": "node scripts/smoke-test-release-gates.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "smoke:ios-simulator-pairing": "zsh scripts/ios-simulator-pairing/run.sh"
  },
  "author": "RoachWares LLC",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "devDependencies": {
    "convex": "^1.46.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "ws": "8.21.3"
  }
}
